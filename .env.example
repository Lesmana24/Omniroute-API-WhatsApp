# Server Configuration (Aplikasi WhatsApp Gateway)
# Gunakan APP_PORT agar tidak menimpa variabel PORT default milik OmniRoute CLI (20128)
APP_PORT=8080
GIN_MODE=release

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=omniroute_wa
DB_SSLMODE=disable

# Omniroute AI API
# Port default resmi OmniRoute CLI adalah 20128 (http://localhost:20128/v1)
OMNIROUTE_API_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key
OMNIROUTE_MODEL=auto

# AI Context Management
MAX_CONTEXT_MESSAGES=10

# WhatsApp Session Storage ("postgres" or "sqlite")
WHATSAPP_SESSION_STORE=postgres
WHATSAPP_SQLITE_PATH=whatsapp_session.db

# Worker Pool Concurrency Settings
WORKER_POOL_SIZE=5
WORKER_QUEUE_SIZE=100
